# Copy to .env — backend loads it automatically
# No keys required: transcription runs on-device (faster-whisper) and
# extraction falls back to offline rules.
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DATABASE=voice.db
BUSINESS_TZ=America/New_York
PUBLIC_BASE_URL=http://127.0.0.1:8000
# On-device transcription model: tiny (fastest), base (default, balanced),
# small, medium. Larger = more accurate, slower on CPU.
WHISPER_MODEL=base
